        const swapFiles = ()=>{
            conceptMarkers.forEach((img)=>{
                const i = parseInt(img.style.getPropertyValue('--i'));
                if (i) // UPDATED: Use the helper function instead of string path
                img.src = getAssetUrl(currentMode, i);
            });
        };
        const updateBtn = ()=>{
            if (toggleBtn) // Logic updated to match your original "Switch to [Opposite]" behavior
            toggleBtn.textContent = isAlternateMode ? `Switch to ${folderLabels.default}` : `Switch to ${folderLabels.alternate}`;
        };
        if (!animate) {
            swapFiles();
            updateBtn();
            return;
        }
        isTransitioning = true;
        conceptMarkers.forEach((img)=>img.classList.add('switching'));
        setTimeout(()=>{
            swapFiles();
            updateBtn();
            requestAnimationFrame(()=>{
                conceptMarkers.forEach((img)=>img.classList.remove('switching'));
                isTransitioning = false;
            });
        }, 400);
    }
