    if (toggleBtn) toggleBtn.addEventListener('click', ()=>{
        isAlternateMode = !isAlternateMode;
        updateImageSources(true);
    });
    function setClock() {
        const now = new Date();
        const milliseconds = now.getMilliseconds();
        const millisecondDegrees = milliseconds / 1000 * 360;
        const seconds = now.getSeconds();
        const secondDegrees = (seconds + milliseconds / 1000) / 60 * 360;
        const minutes = now.getMinutes();
        const minuteDegrees = (minutes + seconds / 60) / 60 * 360;
        const hours = now.getHours();
        const hourDegrees = (hours % 12 + minutes / 60) / 12 * 360;
        const markerIndex = Math.round(seconds / 5) === 0 || Math.round(seconds / 5) === 12 ? 12 : Math.round(seconds / 5);
        conceptMarkers.forEach((img)=>{
            const i = parseInt(img.style.getPropertyValue('--i'));
            if (i === markerIndex) img.classList.add('active-marker');
            else img.classList.remove('active-marker');
        });
        if (hours >= 12) body.classList.add('pm-mode');
        else body.classList.remove('pm-mode');
        millisecondHand.style.transform = `translateX(-50%) rotate(${millisecondDegrees}deg)`;
